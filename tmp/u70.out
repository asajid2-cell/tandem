import { jaSeedContent } from './content/ja/seed.ts';
const collectAudio = (value, out = []) => {
  if (Array.isArray(value)) value.forEach((item) => collectAudio(item, out));
  else if (value && typeof value === 'object') {
    if (typeof value.audioId === 'string') out.push(value.audioId);
    Object.values(value).forEach((item) => collectAudio(item, out));
  }
  return out;
};
const allAudio = collectAudio(jaSeedContent);
const unit70Lex = jaSeedContent.lexicon.filter((entry) => entry.order >= 1407 && entry.order <= 1424);
const unit70Audio = collectAudio(unit70Lex);
const newCollisions = unit70Audio.filter((id) => allAudio.filter((candidate) => candidate === id).length > 1);
console.log(JSON.stringify({
  lexicon: jaSeedContent.lexicon.length,
  scenes: jaSeedContent.scenes.length,
  checkpoints: jaSeedContent.checkpoints.length,
  units: jaSeedContent.units.length,
  unit70LexEntries: unit70Lex.length,
  unit70LexRange: jaSeedContent.units.find((unit) => unit.id === 'ja-unit-70')?.lexRange,
  checkpoint70Items: jaSeedContent.checkpoints.find((checkpoint) => checkpoint.id === 'ja-checkpoint-70')?.items.length,
  unit70AudioIds: unit70Audio.length,
  unit70AudioCollisions: [...new Set(newCollisions)]
}, null, 2));
