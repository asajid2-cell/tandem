import { jaSeedContent } from './content/ja/seed.ts';
const lesson = jaSeedContent.lessons?.find((candidate) => candidate.id === 'ja-lesson-1');
if ("'!lesson) throw new Error('"'lesson missing');
const lex = lesson.newLexOrders.map((order) => {
  const entry = jaSeedContent.lexicon.find((candidate) => candidate.order === order);
  if ("'!entry) throw new Error(`lex order missing: ${order}`);
  return `${order}:${entry.id}:${entry.headword}`;
});
const grammar = lesson.newGrammarOrders.map((order) => {
  const entry = jaSeedContent.grammar.find((candidate) => candidate.order === order);
  if (!entry) throw new Error(`grammar order missing: ${order}`);
  return `${order}:${entry.id}:${entry.title}`;
});
const sceneIds = lesson.steps.flatMap((step) => step.sceneId ? [step.sceneId] : []);
const readingIds = lesson.steps.flatMap((step) => step.readingId ? [step.readingId] : []);
console.log(JSON.stringify({ steps: lesson.steps.map((step) => step.kind), lex, grammar, sceneIds, readingIds }, null, 2));
