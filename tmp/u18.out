import { jaSeedContent } from './content/ja/seed';
const { lexicon, units, checkpoints, scenes } = jaSeedContent;
const unit = units.find((u) => u.id === 'ja-unit-18');
const checkpoint = checkpoints.find((c) => c.id === 'ja-checkpoint-18');
const unitWords = unit ? lexicon.filter((entry) => entry.order >= unit.lexRange[0] && entry.order <= unit.lexRange[1]) : [];
const unitScenes = unit ? scenes.filter((scene) => unit.sceneIds.includes(scene.id)) : [];
