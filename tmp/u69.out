import { jaSeedContent } from './content/ja/seed.ts';
const collectAudio = (value, out = []) => {
  if (Array.isArray(value)) value.forEach((item) => collectAudio(item, out));
  else if (value && typeof value === 'object') {
    if (typeof value.audioId === 'string') out.push(value.audioId);
    Object.values(value).forEach((item) => collectAudio(item, out));
  }
  return out;
};
const allAudio = collectAudio(jaSeedContent);
const unit69Lex = jaSeedContent.lexicon.filter((entry) => entry.order >= 1389 && entry.order <= 1406);
const unit69Audio = collectAudio(unit69Lex);
const newCollisions = unit69Audio.filter((id) => allAudio.filter((candidate) => candidate === id).length > 1);
console.log(JSON.stringify({
  lexicon: jaSeedContent.lexicon.length,
  scenes: jaSeedContent.scenes.length,
  checkpoints: jaSeedContent.checkpoints.length,
  units: jaSeedContent.units.length,
  unit69LexEntries: unit69Lex.length,
  unit69LexRange: jaSeedContent.units.find((unit) => unit.id === 'ja-unit-69')?.lexRange,
  checkpoint69Items: jaSeedContent.checkpoints.find((checkpoint) => checkpoint.id === 'ja-checkpoint-69')?.items.length,
  unit69AudioIds: unit69Audio.length,
  unit69AudioCollisions: [...new Set(newCollisions)]
}, null, 2));
