import fs from 'fs';
import path from 'path';
import { jaSeedContent } from './content/ja/seed.ts';
const units = jaSeedContent.units.filter(u => ['ja-unit-12','ja-unit-13'].includes(u.id));
const lex12 = jaSeedContent.lexicon.filter(e => e.order >= 251 && e.order <= 272);
const lex13 = jaSeedContent.lexicon.filter(e => e.order >= 273 && e.order <= 294);
const sceneIds = new Set(units.flatMap(u=>u.sceneIds));
const scenes = jaSeedContent.scenes.filter(s=>sceneIds.has(s.id));
const checkpoints = jaSeedContent.checkpoints.filter(c=>['ja-checkpoint-12','ja-checkpoint-13'].includes(c.id));
const prompt = "'`Audit Japanese VOCAB Units 12 and 13 for correctness. Unit 12 home/everyday objects; Unit 13 food/meals/restaurant. Check readings, romanization, loanword katakana, naturalness, closed-universe decodability, token arrays, and whether avoiding お酒 in favor of 酒 is acceptable. Be strict and concise: list required fixes or say ship. Context: npm run lint:content passes 0 leaks after these edits; existing vocab through order 250 and grammar through order 132 are available.'"\\n\\nUNITS:\\n"'${JSON.stringify(units,null,2)}'"\\n\\nUNIT 12 LEX:\\n"'${JSON.stringify(lex12,null,2)}'"\\n\\nUNIT 13 LEX:\\n"'${JSON.stringify(lex13,null,2)}'"\\n\\nSCENES:\\n"'${JSON.stringify(scenes,null,2)}'"\\n\\nCHECKPOINTS:\\n"'${JSON.stringify(checkpoints,null,2)}'"\\n"'`;
const outDir = path.resolve('"'..','tandem','tmp');
fs.mkdirSync(outDir,{recursive:true});
const out = path.join(outDir,'ja-units-12-13-audit.txt');
fs.writeFileSync(out,prompt,'utf8');
console.log(out);
console.log("'`lex12=${lex12.length} lex13=${lex13.length} scenes=${scenes.length} checkpoints=${checkpoints.length} chars=${prompt.length}`);
