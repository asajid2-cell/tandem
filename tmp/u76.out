import { jaSeedContent } from './content/ja/seed.ts';
const collectAudio = (value, out = []) => {
  if (Array.isArray(value)) value.forEach((item) => collectAudio(item, out));
  else if (value && typeof value === 'object') {
    if (typeof value.audioId === 'string') out.push(value.audioId);
    Object.values(value).forEach((item) => collectAudio(item, out));
  }
  return out;
};
const allAudio = collectAudio(jaSeedContent);
const unit76Lex = jaSeedContent.lexicon.filter((entry) => entry.order >= 1515 && entry.order <= 1532);
const unit76Audio = collectAudio(unit76Lex);
const newCollisions = unit76Audio.filter((id) => allAudio.filter((candidate) => candidate === id).length > 1);
console.log(JSON.stringify({
  lexicon: jaSeedContent.lexicon.length,
  scenes: jaSeedContent.scenes.length,
  checkpoints: jaSeedContent.checkpoints.length,
  units: jaSeedContent.units.length,
  unit76LexEntries: unit76Lex.length,
  unit76LexRange: jaSeedContent.units.find((unit) => unit.id === 'ja-unit-76')?.lexRange,
  checkpoint76Items: jaSeedContent.checkpoints.find((checkpoint) => checkpoint.id === 'ja-checkpoint-76')?.items.length,
  unit76AudioIds: unit76Audio.length,
  unit76AudioCollisions: [...new Set(newCollisions)]
}, null, 2));
