commands:
  "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command 'npm test'
  "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command 'npm run build'
  "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$ErrorActionPreference = '"'Stop'
"'$port = 4310
$existing = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue
if ($existing) { throw "Port $port is already in use" }
$log = Join-Path $env:TEMP '"'foothold-language-server.log'
"'$err = Join-Path $env:TEMP '"'foothold-language-server.err.log'
"'$db = Join-Path $env:TEMP '"'foothold-language-smoke.sqlite'
Remove-Item -LiteralPath "'$log,$err,$db -Force -ErrorAction SilentlyContinue
$env:PORT = "$port"
$env:AUTH_INTERNAL_KEY = '"'smoke-test-key'
"'$env:AUTH_INTERNAL_URL = '"'http://127.0.0.1:4200'
"'$env:AUTH_COOKIE_NAME = '"'hl_session'
"'$env:DB_PATH = $db
$p = Start-Process -FilePath '"'node' -ArgumentList 'server/index.js' -WorkingDirectory (Get-Location) -RedirectStandardOutput "'$log -RedirectStandardError $err -WindowStyle Hidden -PassThru
try {
  $ready = $false
  for ($i = 0; $i -lt 30; $i++) {
    Start-Sleep -Milliseconds 300
    if ($p.HasExited) { throw "Server exited early with code $($p.ExitCode). stderr: $(Get-Content -Path $err -Raw -ErrorAction SilentlyContinue)" }
    try {
      $health = Invoke-RestMethod -Uri "http://127.0.0.1:$port/api/health" -TimeoutSec 2
      $ready = $true
      break
    } catch {}
  }
  if (-not $ready) { throw '"'Server did not become ready' }
  "'$spa = Invoke-WebRequest -Uri "http://127.0.0.1:$port/language/" -UseBasicParsing -TimeoutSec 5
  $me = Invoke-RestMethod -Uri "http://127.0.0.1:$port/api/me" -TimeoutSec 5
  try {
    Invoke-RestMethod -Uri "http://127.0.0.1:$port/api/keys" -TimeoutSec 5 | Out-Null
    $keysStatus = 200
    $keysBody = '"'unexpected success'
  } catch {
    "'$keysStatus = [int]$_.Exception.Response.StatusCode
    $reader = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream())
    $keysBody = $reader.ReadToEnd()
  }
  [pscustomobject]@{
    healthOk = $health.ok
    spaStatus = [int]$spa.StatusCode
    me = ($me | ConvertTo-Json -Compress)
    keysStatus = $keysStatus
    keysBody = $keysBody
  } | ConvertTo-Json -Compress
} finally {
  if ($p -and -not $p.HasExited) { Stop-Process -Id $p.Id -Force }
  Remove-Item -LiteralPath $db,"$db-shm","$db-wal" -Force -ErrorAction SilentlyContinue
}'
