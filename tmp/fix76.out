import { jaSeedContent } from './content/ja/seed.ts';
const collectAudio = (value, out = []) => {
  if (Array.isArray(value)) value.forEach((item) => collectAudio(item, out));
  else if (value && typeof value === 'object') {
    if (typeof value.audioId === 'string') out.push(value.audioId);
    Object.values(value).forEach((item) => collectAudio(item, out));
  }
  return out;
};
const entry = jaSeedContent.lexicon.find((item) => item.id === 'ja-to-and');
const allAudio = collectAudio(jaSeedContent);
console.log(JSON.stringify({
  toEntry: entry && { order: entry.order, headword: entry.headword, pos: entry.pos, audioId: entry.audioId },
  unit1LexRange: jaSeedContent.units.find((unit) => unit.id === 'ja-unit-1')?.lexRange,
  toKnownInUnit1: Boolean(entry && entry.order >= 1 && entry.order <= 17),
  toAudioIdCount: allAudio.filter((id) => id === 'ja-lex-to-and').length
}, null, 2));
