  cumulativeJaWords: jaSeedContent.lexicon.length,
  unit4Words: lexInUnit4.length,
  unit4Grammar: grammarInUnit4.length,
  unit4Scenes: scenesInUnit4.length,
  unit4SceneLines: scenesInUnit4.reduce((sum, scene) => sum + scene.lines.length, 0),
  unit4SceneQuizItems: scenesInUnit4.reduce((sum, scene) => sum + scene.comprehension.length, 0),
  checkpoint4Items: checkpoint4?.items.length ?? 0
}, null, 2));
