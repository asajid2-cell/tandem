import { jaSeedContent } from './content/ja/seed.ts';
const unit4 = jaSeedContent.units.find((unit) => unit.id === 'ja-unit-4');
const lexInUnit4 = jaSeedContent.lexicon.filter((entry) => entry.order >= 60 && entry.order <= 75);
const grammarInUnit4 = jaSeedContent.grammar.filter((entry) => entry.order >= 76 && entry.order <= 78);
const scenesInUnit4 = jaSeedContent.scenes.filter((scene) => unit4?.sceneIds.includes(scene.id));
const checkpoint4 = jaSeedContent.checkpoints.find((checkpoint) => checkpoint.id === 'ja-checkpoint-4');
console.log(JSON.stringify({
