import { jaSeedContent as c } from './content/ja/seed.ts';
for (const term of ['close','closed','open','please','sorry','thank','welcome','excuse','when','which','why','how','only','except','together','same','different','medicine','pharmacy','clinic','platform','delay','late','emergency','receipt','business','hours','holiday','closed','caution','prohibit','danger','safe','fee','free']) {
 const rows=c.lexicon.filter(e=>e.gloss.toLowerCase().includes(term)).slice(0,12).map(e=>"'`${e.order}'"\\t"'${e.headword}'"\\t"'${e.reading||'"''}\\t"'${e.gloss}`);
 console.log('"'\\n## '+term); console.log(rows.join('\\n')||'NONE');
}
