import { jaSeedContent } from './content/ja/seed.ts';
const maxOrder = Math.max(...jaSeedContent.lexicon.map((entry) => entry.order));
const refs = [];
const collect = (id, owner) => { if (id) refs.push({ id, owner }); };
for (const entry of jaSeedContent.lexicon) { collect(entry.id, "'`lex-id:${entry.id}`); collect(entry.audioId, `lex:${entry.id}`); for (const example of entry.examples) collect(example.audioId, `ex:${entry.id}`); }
for (const scene of jaSeedContent.scenes) { collect(scene.id, `scene-id:${scene.id}`); for (const line of scene.lines) collect(line.audioId, `scene:${scene.id}`); for (const item of scene.comprehension) { collect(item.id, `sceneq-id:${item.id}`); collect(item.audioId, `sceneq:${item.id}`); } }
for (const checkpoint of jaSeedContent.checkpoints) { collect(checkpoint.id, `checkpoint-id:${checkpoint.id}`); for (const item of checkpoint.items) { collect(item.id, `checkpoint-item-id:${item.id}`); collect(item.audioId, `checkpoint:${item.id}`); } }
for (const unit of jaSeedContent.units) collect(unit.id, `unit-id:${unit.id}`);
const byId = new Map();
for (const ref of refs) { const arr = byId.get(ref.id) ?? []; arr.push(ref.owner); byId.set(ref.id, arr); }
const newMarkers = ['"'arigatou','sumimasen','gomen','onegaishimasu','douitashimashite','ohayou','home-platform','noriba','chien','kakueki','kyuukou','receipt','sho-document','ryoushuu','ryoushuusho','itsu','dore','dochira','doushite','dake','shika-only','mouichido','chat-message-exchange','station-delay','checkpoint-78','unit-78'];
const newProblems = [...byId].filter(([id, owners]) => newMarkers.some((marker) => id.includes(marker)) && owners.length "'!== 1);
console.log(JSON.stringify({ lexiconCount: jaSeedContent.lexicon.length, maxLexOrder: maxOrder, unitCount: jaSeedContent.units.length, lastUnitId: jaSeedContent.units.at(-1)?.id, lastCheckpointId: jaSeedContent.checkpoints.at(-1)?.id, newDuplicateIdOrAudioProblems: newProblems }, null, 2));
