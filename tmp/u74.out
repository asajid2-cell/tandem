import { jaSeedContent } from './content/ja/seed.ts';
const collectAudio = (value, out = []) => {
  if (Array.isArray(value)) value.forEach((item) => collectAudio(item, out));
  else if (value && typeof value === 'object') {
    if (typeof value.audioId === 'string') out.push(value.audioId);
    Object.values(value).forEach((item) => collectAudio(item, out));
  }
  return out;
};
const allAudio = collectAudio(jaSeedContent);
const unit74Lex = jaSeedContent.lexicon.filter((entry) => entry.order >= 1479 && entry.order <= 1496);
const unit74Audio = collectAudio(unit74Lex);
const newCollisions = unit74Audio.filter((id) => allAudio.filter((candidate) => candidate === id).length > 1);
console.log(JSON.stringify({
  lexicon: jaSeedContent.lexicon.length,
  scenes: jaSeedContent.scenes.length,
  checkpoints: jaSeedContent.checkpoints.length,
  units: jaSeedContent.units.length,
  unit74LexEntries: unit74Lex.length,
  unit74LexRange: jaSeedContent.units.find((unit) => unit.id === 'ja-unit-74')?.lexRange,
  checkpoint74Items: jaSeedContent.checkpoints.find((checkpoint) => checkpoint.id === 'ja-checkpoint-74')?.items.length,
  unit74AudioIds: unit74Audio.length,
  unit74AudioCollisions: [...new Set(newCollisions)]
}, null, 2));
